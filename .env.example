# Studio accounts use embedded SQLite; no external database credentials required.
# Optional absolute path (default: data/studio.sqlite)
# STUDIO_DB_PATH=/persistent/path/studio.sqlite

# Legacy video/billing modules only
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRICE_ID=your-stripe-pro-price-id
STRIPE_ELITE_PRICE_ID=your-stripe-elite-price-id
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local Studio AI drawings. Keep this server-side; never NEXT_PUBLIC.
OPENAI_API_KEY=
STUDIO_DRAWING_MODEL=gpt-4o
