{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "studio": "node scripts/studio/dev.mjs",
    "studio:renderer": "tsx scripts/studio/render-server.ts",
    "test:studio": "node --import tsx --test tests/studio/*.test.ts",
    "test:studio:browser": "playwright test tests/studio/editor.spec.ts",
    "studio:setup-lipsync": "node scripts/studio/setup-lipsync.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:migrate:local": "wrangler d1 migrations apply STUDIO_DB --local",
    "cf:migrate:remote": "wrangler d1 migrations apply STUDIO_DB --remote"
  },
